# TLS front of staging and production (compose.staging.yaml / compose.prod.yaml):
# this same nginx terminates TLS on 80/443 and hands every request to the
# plain-HTTP application server of default.conf.template, exactly as an
# external proxy would.
#
# Rendered at container start by the nginx image (envsubst):
#   ${NGINX_SERVER_NAME}  <- DJANGO_ALLOWED_HOSTS of the env file
# Certificates: /etc/nginx/tls, maintained by 40-tls-certificates.sh.

# --- Unknown hosts -------------------------------------------------------------

server {
    listen 8081 default_server;
    server_name _;
    return 444;
}

server {
    listen 8443 ssl default_server;
    server_name _;
    ssl_reject_handshake on;
}

# --- HTTP (port 80): ACME challenges, everything else to HTTPS -----------------

server {
    listen 8081;
    server_name ${NGINX_SERVER_NAME};

    # Written by the certbot sidecar (shared volume).
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

# --- HTTPS (port 443) ------------------------------------------------------------

server {
    listen 8443 ssl;
    http2 on;
    server_name ${NGINX_SERVER_NAME};

    # Mozilla "intermediate" profile.
    ssl_certificate     /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:TLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    keepalive_timeout 30s;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        # The address of the connection itself: at the edge no forwarded header
        # is believed.
        proxy_set_header X-Forwarded-For $realip_remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }
}
