# Template for the environments that use a HOSTED Supabase project:
#   .env.staging  (make staging-env)  -> docker/compose.staging.yaml
#   .env.prod     (make prod-env)     -> docker/compose.prod.yaml
#   .env.local    (make local-env)    -> docker/compose.local.yaml (the interface
#                                        on your machine, the data in the cloud;
#                                        the Let's Encrypt values are not used)
# All are gitignored. Fill in every <...> with the values of that environment's
# project: these are REAL credentials, never commit them. Use a different
# Supabase project, secret key and S3 key pair for each environment.
# (Self-hosting on any Postgres / S3 has its own template: .env.selfhost.example.)
#
# DJANGO_DEBUG is fixed in the compose files and ENV comes from the make
# target. With DEBUG off, HTTPS
# redirect, HSTS and secure cookies are on by default (config/settings.py).

# --- Site ---
# Host name(s) of the site, space separated: ledger.example.com, or a private
# name such as partitario.home.arpa. Used by Django (ALLOWED_HOSTS) and nginx
# (server_name); requests for any other name are dropped.
DJANGO_ALLOWED_HOSTS=<ledger.example.com>

# local only: the port on 127.0.0.1 where `make local-up` serves the
# interface, for a machine where 8003 is taken (another project's local stack).
#LOCAL_PORT=8003

# staging / prod (single-purpose server, nginx does TLS on 80/443):
# Let's Encrypt account e-mail. The DNS of the host names must point here.
LETSENCRYPT_EMAIL=<your email>
# true = Let's Encrypt staging CA (untrusted certificates, generous rate
# limits): use it while trying the setup, then delete the `letsencrypt` volume.
LETSENCRYPT_STAGING=false

# Only when the browser reaches the site on a non-standard HTTPS port:
# https://<host>:<port>
#DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Django ---
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=<generate>
# Raise to 31536000 (one year) once HTTPS works on the domain.
DJANGO_SECURE_HSTS_SECONDS=3600

# The admin user is NOT configured here: create it once, interactively, with
# `make <env>-superuser`, so its password is never stored in a file.

# Staff must set up two-factor authentication at their first login. Only
# switch it off for a deployment nobody else can reach.
#DJANGO_STAFF_MFA_REQUIRED=True
# The Content Security Policy blocks what it does not allow. True only reports
# it in the browser console: for finding out what a new page needs, not for
# production.
#DJANGO_CSP_REPORT_ONLY=False

# False closes signup: users are then only created in the admin.
#DJANGO_ACCOUNT_SIGNUP_OPEN=True

# --- Signup bot protection (Cloudflare Turnstile) ---
# staging: leave the keys out, Cloudflare's public test keys are used (the
# widget shows, everybody passes). prod: REQUIRED, the stack does not start on
# the test keys - Cloudflare dashboard -> Turnstile -> Add widget, with the
# site's host name (a free account is enough; the site need not be behind
# Cloudflare). local: switched off by its compose file.
#TURNSTILE_SITE_KEY=<site key>
#TURNSTILE_SECRET_KEY=<secret key>

# --- Mail (address confirmation, password reset, security notifications) ---
# Without EMAIL_HOST mails are only printed to the container log: nobody who
# signs up could confirm their address.
#EMAIL_HOST=<smtp.example.com>
#EMAIL_HOST_USER=<user>
#EMAIL_HOST_PASSWORD=<password>
#EMAIL_DEFAULT_FROM=<partitario@example.com>
# STARTTLS on 587 by default; EMAIL_USE_SSL=True for implicit TLS on 465.
#EMAIL_PORT=587
#EMAIL_USE_SSL=False

# --- Supabase project ---
# Dashboard -> Project Settings -> General -> Project ID. Used only by
# `make <env>-push` to send supabase/migrations to the right project.
SUPABASE_PROJECT_REF=<project-ref>

# --- Supabase Postgres ---
# Django connects as the partitario_app role created by supabase/migrations.
# Set its password once, in the dashboard SQL editor, after `make <env>-push`:
#   alter role partitario_app with password '<database password>';
#
# Dashboard -> Connect -> "Session pooler" (port 5432). Do not use:
#   - the transaction pooler (port 6543): it ignores the search_path option;
#   - the direct connection (db.<ref>.supabase.co): it is IPv6-only and Docker
#     containers usually have no IPv6 route.
DB_NAME=postgres
DB_USER=partitario_app.<project-ref>
DB_PASSWORD=<database password>
DB_HOST=<aws-N-region>.pooler.supabase.com
DB_PORT=5432
DB_SCHEMA=partitario
# `require`: the connection is encrypted.
DB_SSLMODE=require
# Reuse connections: every new one is a TLS handshake to the cloud.
DB_CONN_MAX_AGE=60

# --- Cache ---
# Default: a table in the database, nothing to configure. For a project that
# caches for speed (staging / prod): start the bundled Valkey with
# COMPOSE_PROFILES=cache and point Django at it - or at any Redis of your own:
#COMPOSE_PROFILES=cache
#DJANGO_CACHE_URL=redis://cache:6379/0

# --- Supabase Storage (S3-compatible endpoint, private bucket) ---
# Dashboard -> Storage -> S3 Configuration: enable it, then create an access key.
S3_BUCKET=documents
S3_ENDPOINT_URL=https://<project-ref>.storage.supabase.co/storage/v1/s3
S3_REGION=<project region, e.g. eu-central-1>
S3_ACCESS_KEY_ID=<access key id>
S3_SECRET_ACCESS_KEY=<secret access key>
