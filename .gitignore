backups/
*.dump

# Private keys and certificates
*.pem
*.key

# Machine-specific additions to the hosted stack (proxy network, labels)
docker/compose.override.yaml

# Personal editor / agent settings and OS noise
.claude/settings.local.json
.idea/
.DS_Store
