# Local development environment. Copy to .env (gitignored):  cp .env.example .env
# settings.py loads .env with python-dotenv and fails fast on a missing variable.
#
# The Supabase credentials below are the PUBLIC defaults of the local Supabase
# CLI stack (`supabase start`) — identical on every machine, safe to commit.
# Its ports are not: `make env` writes them here for this worktree.
# For a hosted project, replace them with the real ones (see docs/deployment.md) and never commit that file.

ENV=dev

# --- This worktree (written by `make env`, scripts/worktree-env.sh) ---
# The name of its containers and images, and the port of its Django dev
# server: several worktrees and projects run side by side. Leave them empty
# here; `make env-port` chooses the port again.
WORKTREE_INSTANCE=
DJANGO_DEV_PORT=

# --- Django ---
DJANGO_SECRET_KEY=dev-only-insecure-key-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS="localhost 127.0.0.1"

# Superuser created by `make superuser` (manage.py ensure_superuser): you log
# in with the address
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me
# Background tasks run at once, inside the caller, while DEBUG is on. False
# queues them in the database: then run `cd django && uv run manage.py db_worker`.
#DJANGO_TASKS_IMMEDIATE=True
# True only reports Content Security Policy violations in the browser console.
#DJANGO_CSP_REPORT_ONLY=False
DJANGO_STAFF_MFA_REQUIRED=True
# False closes signup: users are then only created in the admin.
#DJANGO_ACCOUNT_SIGNUP_OPEN=True

# --- Signup bot protection (Cloudflare Turnstile) ---
# Without keys Cloudflare's public test keys are used: the widget shows a
# "testing only" notice and lets everybody through. False removes it.
#TURNSTILE_ENABLED=True
#TURNSTILE_SITE_KEY=
#TURNSTILE_SECRET_KEY=

# --- Supabase Postgres (direct / session-mode connection) ---
# partitario_app is created by supabase/migrations; its local password is set by
# supabase/seed.sql.
DB_NAME=postgres
DB_USER=partitario_app
DB_PASSWORD=partitario_app
DB_HOST=127.0.0.1
# Placeholder: `make env` writes the port of this worktree's local Supabase
# project (chosen by the CLI; `supabase status` shows it).
DB_PORT=54322
DB_SCHEMA=partitario
DB_SSLMODE=prefer

# --- Supabase Storage (S3-compatible endpoint, private bucket) ---
S3_BUCKET=documents
# Placeholder, rewritten by `make env` like DB_PORT.
S3_ENDPOINT_URL=http://127.0.0.1:54321/storage/v1/s3
S3_REGION=local
S3_ACCESS_KEY_ID=625729a08b95bf1b7ff351a663f3a23c
S3_SECRET_ACCESS_KEY=850181e4652dd023b7a98c58ae0d2d34bd487ee0cc3254aed6eda37307425907
