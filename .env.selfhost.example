# Self-hosting: configuration of docker/compose.selfhost.yaml.
#   from a clone   `make selfhost-env` copies this to .env.selfhost and
#                  generates the secrets
#   standalone     save it as `.env` next to compose.selfhost.yaml and replace
#                  every <...>
#
# The defaults run everything in the stack itself: a bundled PostgreSQL and
# the documents in a Docker volume. Nothing here depends on Supabase.

# --- Release ---
# Published images to run. Empty PARTITARIO_VERSION = build from the clone.
PARTITARIO_IMAGE=<registry>/<owner>/partitario
PARTITARIO_VERSION=latest

# --- Site ---
# Host name(s) of the site, space separated: ledger.example.com, or a private
# name such as partitario.home.arpa. Requests for any other name are dropped.
DJANGO_ALLOWED_HOSTS=<partitario.home.arpa>
# The stack serves plain HTTP on this port, on 127.0.0.1 only. Point your
# reverse proxy (Caddy, Traefik, nginx, ...) at it; the proxy does TLS and the
# site only works over HTTPS.
#HTTP_PORT=8080
#BIND_ADDRESS=127.0.0.1
# Only when the browser reaches the site on a non-standard HTTPS port:
# https://<host>:<port>
#DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Django ---
# Generate with: openssl rand -hex 32
DJANGO_SECRET_KEY=<generate>
# Raise to 31536000 (one year) once HTTPS works on the host name.
DJANGO_SECURE_HSTS_SECONDS=3600

# The admin user is NOT configured here: create it once, interactively
# (`make selfhost-superuser`), so its password is never stored in a file.

# Staff must set up two-factor authentication at their first login. Only
# switch it off for a deployment nobody else can reach.
#DJANGO_STAFF_MFA_REQUIRED=True
# The Content Security Policy blocks what it does not allow. True only reports
# it in the browser console: for finding out what a new page needs, not for
# production.
#DJANGO_CSP_REPORT_ONLY=False

# False closes signup: users are then only created in the admin.
#DJANGO_ACCOUNT_SIGNUP_OPEN=True

# --- Signup bot protection (Cloudflare Turnstile) ---
# REQUIRED while signup is open: the stack does not start without them.
# Cloudflare dashboard -> Turnstile -> Add widget, with the site's host name
# (a free account is enough; the site need not be behind Cloudflare). The
# server must reach challenges.cloudflare.com. Or set TURNSTILE_ENABLED=False
# to leave the signup form unprotected.
TURNSTILE_SITE_KEY=<site key>
TURNSTILE_SECRET_KEY=<secret key>
#TURNSTILE_ENABLED=True

# --- Mail (address confirmation, password reset, security notifications) ---
# Without EMAIL_HOST mails are only printed to the container log: nobody who
# signs up could confirm their address.
#EMAIL_HOST=<smtp.example.com>
#EMAIL_HOST_USER=<user>
#EMAIL_HOST_PASSWORD=<password>
#EMAIL_DEFAULT_FROM=<partitario@example.com>
# STARTTLS on 587 by default; EMAIL_USE_SSL=True for implicit TLS on 465.
#EMAIL_PORT=587
#EMAIL_USE_SSL=False

# --- PostgreSQL ---
# Bundled database (default): the `db` profile starts a PostgreSQL container
# with the name, user and password below. Only DB_PASSWORD needs a value.
COMPOSE_PROFILES=db
DB_HOST=db
DB_PORT=5432
DB_NAME=partitario
DB_USER=partitario_app
# Generate with: openssl rand -hex 24
DB_PASSWORD=<generate>
DB_SCHEMA=partitario
DB_SSLMODE=disable
# Seconds a database connection is kept open and reused (0 = one per request).
DB_CONN_MAX_AGE=60
#
# Your own PostgreSQL server (14+) instead: set COMPOSE_PROFILES= (empty) and
# point DB_HOST / DB_PORT at it, after creating once, as an administrator:
#   create role partitario_app login password '<database password>';
#   create database partitario owner partitario_app;
# - a server on this same machine is host.docker.internal, not localhost;
# - behind PgBouncer or another pooler: session mode only;
# - DB_SSLMODE=require whenever the server is on another machine.

# --- Cache ---
# Default: a table in the database, nothing to configure. For a project that
# caches for speed, add `cache` to COMPOSE_PROFILES above (db,cache) to start
# the bundled Valkey, and point Django at it - or at any Redis of your own:
#DJANGO_CACHE_URL=redis://cache:6379/0

# --- Documents ---
# filesystem (default): uploaded documents live in the `media` Docker volume
# and are served only to logged-in users.
DJANGO_STORAGE_BACKEND=filesystem
#
# Any S3-compatible store instead (AWS S3, Cloudflare R2, Backblaze B2, Garage,
# SeaweedFS, MinIO, ...): set DJANGO_STORAGE_BACKEND=s3, create a PRIVATE bucket and
# an access key that can read, write and delete objects in it.
#DJANGO_STORAGE_BACKEND=s3
#S3_BUCKET=<bucket name>
#S3_REGION=<region>
#S3_ACCESS_KEY_ID=<access key id>
#S3_SECRET_ACCESS_KEY=<secret access key>
# The API endpoint, which the BROWSER must also reach: download links point at
# it. Leave empty for AWS S3.
#   Cloudflare R2  https://<account id>.r2.cloudflarestorage.com   (region: auto)
#   Backblaze B2   https://s3.<region>.backblazeb2.com
#S3_ENDPOINT_URL=<https://s3.example.com>
# path (default): https://endpoint/bucket/key. virtual: https://bucket.endpoint/key (AWS S3).
#S3_ADDRESSING_STYLE=path
