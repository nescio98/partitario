#: apps/accounts/middleware.py
msgid "Set up two-factor authentication to continue: it is required."
msgstr ""
"Per continuare configura l'autenticazione a due fattori: è obbligatoria."

#: apps/accounts/models.py
msgid "email address"
msgstr "indirizzo email"

#: apps/accounts/models.py
msgid "A user with this email address already exists."
msgstr "Esiste già un utente con questo indirizzo email."

#: apps/accounts/models.py
msgid "staff status"
msgstr "privilegi di staff"

#: apps/accounts/models.py
msgid "Designates whether the user can log into this admin site."
msgstr "Indica se l'utente può accedere a questo sito di amministrazione."

#: apps/accounts/models.py
msgid "active"
msgstr "attivo"

#: apps/accounts/models.py
msgid ""
"Designates whether this user should be treated as active. Unselect this "
"instead of deleting accounts."
msgstr ""
"Indica se l'utente deve essere considerato attivo. Deseleziona qui invece di "
"eliminare gli account."

#: apps/accounts/models.py
msgid "date joined"
msgstr "data di iscrizione"

#: apps/accounts/models.py
msgid "user"
msgstr "utente"

#: apps/accounts/models.py
msgid "users"
msgstr "utenti"

#: apps/accounts/models.py
msgid "The email address must be lowercase."
msgstr "L'indirizzo email deve essere in minuscolo."

#: apps/accounts/third_party_messages.py
#, python-format
msgid "You are currently working on behalf of <em>%(user)s</em>."
msgstr "Stai operando come <em>%(user)s</em>."

#: apps/accounts/third_party_messages.py
msgid "stop impersonating"
msgstr "smetti di impersonare"

#: apps/accounts/third_party_messages.py
