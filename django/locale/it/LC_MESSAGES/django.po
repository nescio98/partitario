msgstr "impersona %(username)s"

#: apps/accounts/third_party_messages.py
msgctxt "verb"
msgid "impersonate"
msgstr "impersona"

#: apps/accounts/turnstile.py
msgid "Confirm that you are not a robot."
msgstr "Conferma di non essere un robot."

#: apps/accounts/turnstile.py
msgid "The verification failed. Try again."
msgstr "La verifica non è riuscita. Riprova."

#: apps/accounts/views.py
msgid "Your account was deleted."
msgstr "Il tuo account è stato eliminato."

#: apps/core/models.py
msgid "maintenance mode"
msgstr "modalità manutenzione"

#: apps/core/models.py
msgid ""
"While on, visitors get a maintenance page (HTTP 503). Staff and the admin "
"site keep working."
msgstr ""
"Quando è attiva, i visitatori vedono una pagina di manutenzione (HTTP 503). "
"Lo staff e il pannello di amministrazione continuano a funzionare."

#: apps/core/models.py
msgid "last change"
msgstr "ultima modifica"

#: apps/core/models.py
msgid "On"
