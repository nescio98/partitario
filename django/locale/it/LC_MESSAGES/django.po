#: templates/400.html
msgid "Bad request"
msgstr "Richiesta non valida"

#: templates/400.html
msgid "The request could not be understood. Go back and try again."
msgstr "La richiesta non è stata compresa. Torna indietro e riprova."

#: templates/403.html
msgid "Access denied"
msgstr "Accesso negato"

#: templates/403.html
msgid "You do not have permission to open this page."
msgstr "Non hai i permessi per aprire questa pagina."

#: templates/404.html
msgid "Page not found"
msgstr "Pagina non trovata"

#: templates/404.html
msgid "The page you are looking for does not exist or has been moved."
msgstr "La pagina che cerchi non esiste o è stata spostata."

#: templates/500.html
msgid "Something went wrong"
msgstr "Qualcosa è andato storto"

#: templates/500.html
msgid "An unexpected error occurred on our side. Please try again in a moment."
msgstr "Si è verificato un errore imprevisto. Riprova tra qualche istante."

#: templates/503.html
msgid "Back soon"
msgstr "Torniamo presto"

#: templates/503.html
msgid "The site is under maintenance. Please try again in a little while."
msgstr "Il sito è in manutenzione. Riprova tra poco."

#: templates/account/delete.html templates/account/manage.html
msgid "Delete account"
msgstr "Elimina account"

#: templates/account/delete.html
#, python-format
msgid ""
"The account <strong>%(email)s</strong> and everything in it will be removed "
"for good. This cannot be undone."
msgstr ""
"L'account <strong>%(email)s</strong> e tutto ciò che contiene saranno "
"eliminati definitivamente. L'operazione non può essere annullata."

#: templates/account/delete.html
msgid "Delete my account"
msgstr "Elimina il mio account"

#: templates/account/delete.html
msgid "Cancel"
msgstr "Annulla"

